# Copy to ansible.env (gitignored) and fill in real values.
GATEPI_HOST=192.168.x.x
GATEPI_USER=pi
ANSIBLE_BECOME_PASSWORD=your-become-password
ALPRD_STREAM=/dev/video10
ALPRD_RTSP_URL=rtsp://user:pass@camera-ip:554/H264/ch1/main/av_stream
ALPRD_V4L2_DEVICE=/dev/video10
ALPRD_V4L2_WEB_DEVICE=/dev/video11
ALPRD_V4L2_FPS=4
ALPRD_V4L2_EXCLUSIVE_CAPS=1,1
ALPRD_CPU_AFFINITY=
ALPRD_ROI=
GATE_WEB_STREAM_RTSP_URL=rtsp://user:pass@camera-ip:554/H264/ch1/main/av_stream
GATE_WEB_STREAM_URL=/static/stream.jpg
GATE_WEB_STREAM_FPS=6
GATE_WEB_STREAM_ENCODER=libx264
GATE_WEB_STREAM_WIDTH=1280
GATE_WEB_STREAM_HEIGHT=720
