# Copy to ansible.env (gitignored) and fill in real values.
GATEPI_USER=pi
ANSIBLE_BECOME_PASSWORD=your-become-password
ALPRD_STREAM=rtsp://user:pass@camera-ip:554/h264Preview_01_main
ALPRD_CPU_AFFINITY=
ALPRD_ROI=1,208,2092,888
GATEPI_ALIAS_HOSTNAME=gate
# Pin the OpenALPR commit SHA used on the live Pi.
# Run: ssh pi@<pi-ip> 'cd /opt/openalpr && git rev-parse HEAD'
# then set OPENALPR_SHA to that value.
OPENALPR_SHA=HEAD
# Optional HTTPS using an already-issued trusted certificate on the Pi.
# HTTP by LAN IP and .local remains available. With HTTPS on, the bare-hostname
# homepage redirects to GATE_HTTPS_DOMAIN; API and dedicated screen URLs stay HTTP.
GATE_HTTPS_ENABLED=false
GATE_HTTPS_DOMAIN=
# Example only: GATE_HTTPS_DOMAIN=gate.example.com
GATE_HTTPS_CERT_PATH=/etc/gate-anpr/tls/fullchain.pem
GATE_HTTPS_KEY_PATH=/etc/gate-anpr/tls/privkey.pem
# Optional automated DNS-01 issuance through a dedicated DuckDNS alias.
# Both flags must be true before credentials are read or DNS is changed.
GATE_HTTPS_ACME_ENABLED=false
GATE_HTTPS_CHALLENGE_ALIAS=
# Example: GATE_HTTPS_CHALLENGE_ALIAS=my-gate-acme.duckdns.org
# Store DuckDNS_Token=<token> in gitignored files/gate_https_dns.env (mode 0600).
